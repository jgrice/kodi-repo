<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.jgrice" name="Justin's Kodi Repo" version="1.0.0" provider-name="jgrice">
    <extension point="xbmc.addon.repository" name="Justin's Kodi Repo">
        <!-- Our own add-ons (the pack). build.py fills in the site URL -->
        <dir>
            <info compressed="false">https://jgrice.github.io/kodi-repo/addons.xml</info>
            <checksum>https://jgrice.github.io/kodi-repo/addons.xml.md5</checksum>
            <datadir zip="true">https://jgrice.github.io/kodi-repo/</datadir>
        </dir>
        <!-- Upstream: POV + Magneto (kodifitzwell, two mirrors) -->
        <dir minversion="19.0.0">
            <info compressed="false">https://kodifitzwell.github.io/repo/packages/addons.xml</info>
            <checksum>https://kodifitzwell.github.io/repo/packages/addons.xml.md5</checksum>
            <datadir zip="true">https://kodifitzwell.github.io/repo/</datadir>
        </dir>
        <dir minversion="19.0.0">
            <info compressed="false">https://kodiyashimaru.github.io/repo/packages/addons.xml</info>
            <checksum>https://kodiyashimaru.github.io/repo/packages/addons.xml.md5</checksum>
            <datadir zip="true">https://kodiyashimaru.github.io/repo/</datadir>
        </dir>
        <!-- To add Otaku later, uncomment this and add the import in script.jgrice.pack/addon.xml
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/Goldenfreddy0703/repository.hooty/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Goldenfreddy0703/repository.hooty/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Goldenfreddy0703/repository.hooty/master/repo/zips/</datadir>
        </dir>
        -->
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Justin's add-on pack repository</summary>
        <description lang="en_GB">Install "Justin's Pack" from here to get the full add-on set.</description>
        <platform>all</platform>
    </extension>
</addon>
<addon id="script.jgrice.pack" name="Justin's Pack" version="1.0.0" provider-name="jgrice">
    <!-- Everything listed here is installed (and kept updated) when the pack is installed.
         To change what every device gets: edit this list, bump version above, run build.py, push. -->
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="plugin.video.pov"/>
        <import addon="script.module.magneto"/>
        <!-- <import addon="plugin.video.otaku"/> -->
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Installs Justin's add-on set and applies device settings</summary>
        <description lang="en_GB">Installing this pulls in POV and its scrapers. Run it once from Program add-ons to apply recommended Fire Stick settings (cache size, safe update mode).</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
