<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.jgrice.pack.pc" name="Justin's Pack (PC)" version="1.0.0" provider-name="jgrice">
    <!-- Everything listed here is installed (and kept updated) when the pack is installed.
         To change what every device gets: edit this list, bump version above, run build.py, push. -->
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="plugin.video.pov"/>
        <import addon="script.module.magneto"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Justin's add-on set for Windows PC</summary>
        <description lang="en_GB">Installs POV and its scrapers. Open it from Program add-ons to sign in to TorBox / Trakt (QR code) and apply PC settings (512 MB cache, safe update mode).</description>
        <platform>all</platform>
    </extension>
</addon>
