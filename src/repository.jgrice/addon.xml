<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.jgrice" name="Justin's Kodi Repo" version="1.2.1" provider-name="jgrice">
    <extension point="xbmc.addon.repository" name="Justin's Kodi Repo">
        <!-- Packs plus mirrored copies of Arctic Horizon 2 and its helpers -->
        <dir>
            <info compressed="false">{SITE_URL}addons.xml</info>
            <checksum>{SITE_URL}addons.xml.md5</checksum>
            <datadir zip="true">{SITE_URL}</datadir>
        </dir>
        <!-- POV + Magneto come straight from their author's repo (not copied here) -->
        <dir minversion="19.0.0">
            <info compressed="false">https://raw.githubusercontent.com/kodifitzwell/repo/master/packages/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/kodifitzwell/repo/master/packages/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/kodifitzwell/repo/master/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Justin's add-on pack repository</summary>
        <description lang="en_GB">Install "Justin's Pack" from here to get the full add-on set.</description>
        <platform>all</platform>
    </extension>
</addon>
